# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.npm
venv/
backend/venv/


# ─── Environment Files ────────────────────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
frontend/.env
frontend/.env.local
backend/.env
backend/.env.local

# ─── Build Outputs ───────────────────────────────────────────────────────────
dist/
build/
frontend/dist/
frontend/build/

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
