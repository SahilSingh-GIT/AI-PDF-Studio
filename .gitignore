backend/src/logs/**

# ─── Runtime & Upload Directories ────────────────────────────────────────────
backend/src/uploads/*
backend/src/temp/*
!backend/src/uploads/.gitkeep
!backend/src/temp/.gitkeep
!backend/src/logs/.gitkeep

# ─── Storage (production file storage) ───────────────────────────────────────
backend/storage/originals/*
backend/storage/processed/*
backend/storage/thumbnails/*
backend/storage/temp/*
!backend/storage/originals/.gitkeep
!backend/storage/processed/.gitkeep
!backend/storage/thumbnails/.gitkeep
!backend/storage/temp/.gitkeep

